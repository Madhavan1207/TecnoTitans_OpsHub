{
  "name": "opshub-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "start:offline": "node src/index.js --offline",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js",
    "test": "node --test --test-concurrency=1 --env-file-if-exists=.env.test \"test/*.test.js\"",
    "db:create": "node --env-file-if-exists=.env scripts/createdb.js",
    "pretest": "node --env-file-if-exists=.env.test scripts/createdb.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}