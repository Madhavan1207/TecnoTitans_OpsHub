# PostgreSQL superuser/owner (used ONLY for migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opshub
# The app connects as the restricted role created by the migration so RLS is enforced.
# (Defaults to opshub_app:opshub_app on the same database if omitted.)
APP_DATABASE_URL=postgresql://opshub_app:opshub_app@localhost:5432/opshub
JWT_SECRET=change-me-in-production
PORT=4000

# Resend Email Configuration (Customer repair completion notifications)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
# Optional sender (default: OpsHub <onboarding@resend.dev>)
# RESEND_FROM=OpsHub <onboarding@resend.dev>
