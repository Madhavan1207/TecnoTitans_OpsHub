
# ---- SMS updates to customers (Service Centre) ----
# log = print messages to the server console and show them in the app (no account needed, best for demos)
# twilio | fast2sms | webhook = real SMS (fill in the matching values below)
SMS_PROVIDER=log
DEFAULT_COUNTRY_CODE=91
# Used to put a tracking link inside the SMS, e.g. http://192.168.1.10:4000 or your public URL
PUBLIC_BASE_URL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx
# FAST2SMS_API_KEY=
# SMS_WEBHOOK_URL=
